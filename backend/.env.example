# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file path used by Prisma)
DATABASE_URL="file:./dev.db"

# OpenAI
# Leave OPENAI_API_KEY empty to run the app in DEMO/FALLBACK mode, which uses
# deterministic rule-based extraction instead of calling the OpenAI API.
# This lets the whole pipeline be demoed and tested without any API key/cost.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upload limits
MAX_UPLOAD_FILE_SIZE_MB=8
MAX_RESUMES_PER_REQUEST=20
