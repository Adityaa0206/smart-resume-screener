# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file path used by Prisma)
DATABASE_URL="file:./dev.db"

# Gemini
# Leave GEMINI_API_KEY empty to run the app in DEMO/FALLBACK mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Upload limits
MAX_UPLOAD_FILE_SIZE_MB=8
MAX_RESUMES_PER_REQUEST=20
